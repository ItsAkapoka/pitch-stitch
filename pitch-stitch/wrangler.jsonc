{
  // The Pitch Stitch by Thread Studio. Cloudflare Workers settings. No need to edit.
  "name": "pitch-stitch",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Keeps the keys you add in the Cloudflare dashboard safe on every redeploy.
  "keep_vars": true
}
